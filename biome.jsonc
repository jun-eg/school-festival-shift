{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.js", "src/**/*.mjs", "scripts/**/*.js", "scripts/**/*.mjs"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 320
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "assist": {
    "actions": {
      "source": {
        // import の並べ替えは書式でなく中身の差分になる。この issue の範囲外
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "complexity": {
        // 列見出し（日本語）を row['氏名'] と書く検査が多く、ドット記法に直す利点が無い
        "useLiteralKeys": "off",
        // 書き方の好みを強いる規則。書き直しは次の親（src/ の根本リファクタ）で決める
        "useArrowFunction": "off",
        "useOptionalChain": "off"
      },
      "style": {
        // strict の型を通した後の ! で、検査の中に多い。外すと検査の読みが悪くなる
        "noNonNullAssertion": "off",
        // 書き方の好み。書き直しは次の親で決める
        "useTemplate": "off"
      },
      "suspicious": {
        // 偽の spreadsheet／form を型で縛らず any で受ける所が test/fakes と検査に残る。型付けは次の親で決める
        "noExplicitAny": "off"
      }
    }
  }
}
