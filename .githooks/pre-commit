#!/bin/sh
# pre-commit — commit の前に、repo の文書の検査を回す。
#
# 有効にする: git config core.hooksPath .githooks（手順は CONTRIBUTING.md）
# 止まったときの直し方は docs/README.md の「古さの check」。
# lint・型・テスト（npm test）は issue #310 でここに足す。

set -e
cd "$(git rev-parse --show-toplevel)"

node scripts/リンクの検査.mjs
node scripts/要約の検査.mjs
