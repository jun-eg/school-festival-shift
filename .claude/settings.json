{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --amend:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-bash.py\"",
            "statusMessage": "危ない形でないか見ている",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
